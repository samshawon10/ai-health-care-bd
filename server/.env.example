NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
# For multiple deployed origins, use comma-separated values.
CLIENT_ORIGINS=http://localhost:3000

# Required for persistence
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/ai-healthcare-bd
# MongoDB Atlas:
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.cw14vfx.mongodb.net/ai-healthcare-bd?retryWrites=true&w=majority&appName=Cluster0
MONGODB_REQUIRED=false

# Required for backend Firebase ID-token verification in production.
# Never commit a real service account private key.
FIREBASE_PROJECT_ID=ai-healthcare-bd
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ai-healthcare-bd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_ROTATED_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_REQUIRED=false

# Required for live AI responses
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REQUEST_TIMEOUT_MS=20000
OPENAI_MAX_INPUT_CHARS=6000
OPENAI_SKIP_EMERGENCY_AI=true
